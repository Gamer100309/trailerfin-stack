# ============================================================
# Konfiguration - kopiere diese Datei zu ".env" und trage deine
# eigenen Werte ein:
#
#   cp .env.example .env
#   nano .env
#
# ============================================================

# --- Allgemein ---
TZ=Europe/Berlin

# --- Medien-Pfad ---
# Pfad auf dem Host, unter dem deine Filme/Serien liegen (bzw. liegen sollen).
# Muss die Unterordner enthalten, die unten bei MOVIE_FOLDER_NAME /
# TV_FOLDER_NAME angegeben sind.
MEDIA_PATH=./media

# Namen der Unterordner innerhalb von MEDIA_PATH (an deine bestehende
# Radarr/Sonarr Root-Folder-Struktur anpassen, falls abweichend)
MOVIE_FOLDER_NAME=Filme
TV_FOLDER_NAME=Serien
MUSIC_FOLDER_NAME=Musik

# --- TMDb API-Key (Pflicht) ---
# Kostenlos erstellen unter: https://www.themoviedb.org/settings/api
# (Nutzungsart "Personal" auswählen)
TMDB_API_KEY=

# --- Trailerfin Verhalten ---
# "link"     = erzeugt .strm-Verweise (kein Speicherplatz, braucht ytdlp2strm dauerhaft laufend)
# "download" = lädt Trailer als echte .mp4-Datei herunter (mehr Speicherplatz, unabhängig von ytdlp2strm danach)
TRAILERFIN_MODE=link

# Bevorzugte Sprache für Trailer (z.B. de-DE, en-US). Fällt automatisch auf die
# Standard-Sprache zurück, falls kein Trailer in dieser Sprache existiert.
TRAILERFIN_PREFERRED_LANGUAGE=de-DE

# Priorisierte Liste bevorzugter YouTube-Kanäle (kommagetrennt, Reihenfolge = Priorität).
# Leer lassen, um das einfach zu deaktivieren.
TRAILERFIN_CHANNEL_WHITELIST=

# Kanäle, die nie verwendet werden sollen (kommagetrennt).
TRAILERFIN_CHANNEL_BLACKLIST=

# Cron-Schedule für automatische Scans (Standard: täglich um Mitternacht)
TRAILERFIN_SCHEDULE=0 0 0 * * *

# Radarr/Sonarr Ordnerformat-Anforderung:
# Damit Trailerfin Filme/Serien findet, müssen die Ordnernamen ein TMDb-Tag
# enthalten, z.B. "Der Pate (1972) {tmdb-238}" oder "[tmdbid-238]" -
# Klammertyp, Reihenfolge und "tmdb"/"tmdbid" sind dabei egal.
# Siehe README.md, Abschnitt "Radarr/Sonarr Einrichtung".
